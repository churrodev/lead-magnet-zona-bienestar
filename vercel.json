{
  "": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/lead-magnet", "destination": "/index.html" },
    { "source": "/herramienta", "destination": "/index.html" }
  ]
}
